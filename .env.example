MINUTES_DATA_DIR=./data
MINUTES_MAX_UPLOAD_MB=200
# Provision these directories before implementing/running inference.
MINUTES_STT_MODEL_DIR=./models/whisper
MINUTES_DIARIZATION_MODEL_DIR=./models/diarization
MINUTES_OLLAMA_URL=http://127.0.0.1:11434
MINUTES_OLLAMA_MODEL=qwen2.5:7b
MINUTES_FFMPEG=ffmpeg
MINUTES_DEVICE=cpu
MINUTES_COMPUTE_TYPE=int8
# Optional STT-only overrides; pyannote continues using MINUTES_DEVICE.
# MINUTES_STT_DEVICE=cuda
# MINUTES_STT_COMPUTE_TYPE=int8_float16
MINUTES_MAX_AUDIO_SECONDS=7200
MINUTES_PDF_FONT=./static/fonts/DejaVuSans.ttf
HF_HUB_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
PYANNOTE_METRICS_ENABLED=0
OLLAMA_NO_CLOUD=1
